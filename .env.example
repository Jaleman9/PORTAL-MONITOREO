# ==========================================
# Configuración del Entorno - Web Analytics Platform
# ==========================================

# RabbitMQ (Broker de Mensajería)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ClickHouse (Base de Datos Analítica OLAP)
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Collector & Privacy
# Salt criptográfico para generación de hashes HMAC-SHA256 de identificadores de usuario (minimización de datos / RGPD)
ANALYTICS_SALT=corporacion-analytics-secret-salt-latam-2026

# Consumer Pipeline (Micro-batching)
CONSUMER_BATCH_SIZE=100
CONSUMER_BATCH_TIMEOUT=1.5
